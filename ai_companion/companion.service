# Example of the systemd user service that starts Rabbit at boot.
# Don't copy this by hand: run  bash install_autostart.sh  instead. It writes
# this file with the right paths to ~/.config/systemd/user/, enables it,
# makes it start without logging in, and makes sure Ollama starts at boot.
#
# Logs:  journalctl --user-unit companion -f

[Unit]
Description=Rabbit voice companion
After=pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
WorkingDirectory=%h/stg-make-a-thon-21/ai_companion
ExecStartPre=/bin/sleep 10
ExecStart=%h/stg-make-a-thon-21/ai_companion/venv/bin/python %h/stg-make-a-thon-21/ai_companion/main.py
Environment=PYTHONUNBUFFERED=1
# A crash restarts Rabbit; "mayday" exits cleanly and stays stopped.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
